<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/general_settings">

        <SwitchPreference
            android:defaultValue="true"
            android:key="startBoot"
            android:title="@string/auto_start" />

        <ListPreference
            android:defaultValue="en"
            android:entries="@array/language_entries"
            android:entryValues="@array/language_values"
            android:key="language"
            android:title="Language / زبان" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/privacy_settings">

        <SwitchPreference
            android:defaultValue="false"
            android:key="strict_encrypted_dns"
            android:summary="@string/strict_encrypted_dns_summary"
            android:title="@string/strict_encrypted_dns" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="allow_fallback_resolver"
            android:summary="@string/allow_fallback_resolver_summary"
            android:title="@string/allow_fallback_resolver" />

    </PreferenceCategory>

</PreferenceScreen>
